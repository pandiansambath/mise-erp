# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
# Screenshots the live checks write. Evidence for the run that made them,
# not something the repo should carry.
/e2e-out/
/blob-report/
/playwright/.cache/
/e2e/__screens__/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
e2e/verify-*.spec.ts

# Watcher agents write throwaway verification specs here while checking a
# deploy on the live site. They are scratch, not tests: named for one commit,
# deleted by the agent afterwards. They kept getting swept into commits because
# I stage with `git add -A`, so one agent's scratch file ended up tracked and
# the NEXT agent's deletion of it showed as a real change. Ignore them at the
# source rather than remembering not to add them.
e2e/tmp-*.spec.ts
